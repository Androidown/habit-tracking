{
  "name": "habit-tracking-server",
  "version": "1.0.0",
  "description": "Habit Tracking App - Backend Server",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test": "jest --coverage",
    "test:sentry": "jest --testPathPattern='sentry'",
    "test:metrics": "jest --testPathPattern='api-metrics'"
  },
  "dependencies": {
    "@sentry/node": "^7.114.0",
    "@sentry/tracing": "^7.114.0",
    "better-sqlite3": "^12.11.1",
    "express": "^4.19.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
